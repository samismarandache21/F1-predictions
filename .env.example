# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=f1strategy
POSTGRES_USER=f1strategy
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg://f1strategy:changeme@localhost:5432/f1strategy

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Data sources ---
# OpenF1 historical data needs no key. Live data requires a paid subscription (M6+); leave blank until then.
OPENF1_API_BASE=https://api.openf1.org/v1
OPENF1_LIVE_API_KEY=

# Jolpica requires a descriptive User-Agent per their terms.
JOLPICA_API_BASE=https://api.jolpi.ca/ergast/f1
JOLPICA_USER_AGENT=f1-strategy/0.1 (personal, non-commercial)

# FastF1 local cache directory (gitignored)
FASTF1_CACHE_DIR=./data/fastf1_cache

# Open-Meteo needs no key.
OPEN_METEO_API_BASE=https://api.open-meteo.com/v1

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:4200

# --- App ---
ENV=development
LOG_LEVEL=INFO
